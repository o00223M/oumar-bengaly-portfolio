# Copiez ce fichier en ".env" et remplissez les valeurs.
# Toutes ces informations se trouvent dans votre projet Supabase
# (Project Settings → Database, et Project Settings → API).

# Connexion "pooled" (Transaction pooler, port 6543) — utilisée à l'exécution.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe (port 5432) — utilisée uniquement pour les migrations Prisma.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# Project URL (Project Settings → API → Project URL).
SUPABASE_URL="https://xxxx.supabase.co"

# Service role key (Project Settings → API → service_role secret).
# Ne jamais exposer cette clé côté client, ni la commiter dans Git.
SUPABASE_SERVICE_ROLE_KEY="changez-moi"

# Project URL (identique à SUPABASE_URL) et clé publique "publishable" /
# "anon" (Project Settings → API). Ces deux variables sont exposées au
# navigateur (préfixe NEXT_PUBLIC_) : elles servent au téléversement des
# fichiers volumineux (vidéos) directement depuis l'admin vers Supabase,
# sans passer par le serveur.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="changez-moi"

# Mot de passe de connexion à l'espace admin (/admin/login).
ADMIN_PASSWORD="changez-moi"

# Secret de signature des sessions admin — une longue chaîne aléatoire.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="changez-moi"
